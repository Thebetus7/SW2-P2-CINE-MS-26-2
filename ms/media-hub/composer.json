{
    "name": "cinecenter/media-hub",
    "type": "project",
    "description": "Monolito Fullstack de Multimedia, Terminal POS y Boletos Digitales (Laravel 11 + Inertia + Vue 3)",
    "keywords": ["laravel", "inertia", "vue", "minio", "mongodb", "cinema"],
    "license": "MIT",
    "require": {
        "php": "^8.2|^8.3|^8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
